<!--
    The stacked layout: the icon and the text beside it, and the call-to-action button on its own
    line under them, as wide as the ad. The icon is as high as what's left over the button, so it
    grows with the slot. The views have the row layout's ids (simple_native_ad.xml), so the
    factory colors and pads both alike. The text's end keeps clear of the AdChoices icon in the
    top-right corner (SimpleNativeAdFactory sets its margin from the right padding).
-->
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/simple_native_ad"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/background"
            android:layout_width="@dimen/ad_banner_no_size"
            android:layout_height="@dimen/ad_banner_no_size"
            android:layout_marginStart="@dimen/ad_banner_stacked_side_margin"
            android:layout_marginTop="@dimen/ad_banner_stacked_margin"
            android:layout_marginEnd="@dimen/ad_banner_stacked_side_margin"
            android:layout_marginBottom="@dimen/ad_banner_stacked_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginBottom="@dimen/ad_banner_stacked_gap"
                android:background="@drawable/ad_banner_icon_background"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toTopOf="@id/cta"
                app:layout_constraintDimensionRatio="W,1:1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/ad_banner_stacked_gap"
                android:layout_marginEnd="@dimen/ad_banner_stacked_adchoices_room"
                android:gravity="center_vertical"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="@id/icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/icon"
                app:layout_constraintTop_toTopOf="@id/icon"
                app:layout_goneMarginStart="0dp">

                <TextView
                    android:id="@+id/primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/ad_banner_default_text"
                    android:textSize="@dimen/ad_banner_stacked_text_size_large"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/row_two"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/ad_notification_view"
                        android:layout_width="@dimen/ad_banner_ad_indicator_width"
                        android:layout_height="@dimen/ad_banner_ad_indicator_height"
                        android:layout_marginEnd="@dimen/ad_banner_default_margin"
                        android:background="@drawable/ad_banner_ad_label_background"
                        android:gravity="center"
                        android:text="Ad"
                        android:textColor="@color/ad_banner_ad_label_text"
                        android:textSize="@dimen/ad_banner_ad_indicator_text_size" />

                    <TextView
                        android:id="@+id/secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/ad_banner_gray_text"
                        android:textSize="@dimen/ad_banner_text_size_small" />

                </LinearLayout>

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/cta"
                android:layout_width="0dp"
                android:layout_height="@dimen/ad_banner_stacked_cta_button_height"
                android:background="@drawable/ad_banner_cta_button_background"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:hint="Install"
                android:lines="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="16dp"
                android:paddingTop="0dp"
                android:paddingEnd="16dp"
                android:paddingBottom="0dp"
                android:stateListAnimator="@null"
                android:textColor="@color/ad_banner_cta_text"
                android:textSize="@dimen/ad_banner_text_size_cta"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.gms.ads.nativead.NativeAdView>
